# Hostinger / Apache hardening for the PHP backend
Options -Indexes

# Block direct access to config and library files
<FilesMatch "^(config\.php|schema\.sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib/ - [F,L]
</IfModule>

# Uploaded files: never execute, only download
<IfModule mod_headers.c>
  <FilesMatch "\.(pdf|jpg|jpeg|png)$">
    Header set X-Content-Type-Options nosniff
  </FilesMatch>
</IfModule>
